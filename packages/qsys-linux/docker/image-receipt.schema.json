{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/reowens/qsys-tools/qsys-image-receipt.schema.json",
  "title": "Q-SYS vendor-free image build receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "image",
    "reference",
    "digest",
    "digestKind",
    "imageId",
    "sourceRevision",
    "sourceMode",
    "published",
    "verification",
    "platform",
    "contextSha256",
    "inputs",
    "bases",
    "compiler",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "$ref": "#/$defs/digest"
    },
    "digestKind": {
      "enum": [
        "manifest",
        "image-id"
      ]
    },
    "imageId": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "enum": [
        "pending",
        "verified"
      ]
    },
    "sourceRevision": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      ]
    },
    "sourceMode": {
      "enum": [
        "committed",
        "development"
      ]
    },
    "published": {
      "type": "boolean"
    },
    "platform": {
      "const": "linux/amd64"
    },
    "contextSha256": {
      "$ref": "#/$defs/hash"
    },
    "inputs": {
      "type": "object",
      "required": [
        "Dockerfile",
        ".dockerignore",
        "entrypoint.sh",
        "dpkg-deb.py",
        "smoke.py",
        "qrc-smoke.mjs",
        "qsys-linux.tgz",
        "qsys-qrc.tgz",
        "execution.py",
        "qemu-shim.py",
        "qemu-pin.json",
        "wine-procmem.c"
      ],
      "propertyNames": {
        "enum": [
          "Dockerfile",
          ".dockerignore",
          "entrypoint.sh",
          "dpkg-deb.py",
          "smoke.py",
          "qrc-smoke.mjs",
          "image-receipt.schema.json",
          "qsys-linux.tgz",
          "qsys-qrc.tgz",
          "execution.py",
          "qemu-shim.py",
          "qemu-pin.json",
          "wine-procmem.c"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "@sha256:[a-f0-9]{64}$"
      }
    },
    "compiler": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "imageId": {
            "$ref": "#/$defs/digest"
          }
        }
      },
      "else": {
        "properties": {
          "published": {
            "const": true
          },
          "imageId": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "sourceMode": {
            "const": "development"
          }
        }
      },
      "then": {
        "properties": {
          "sourceRevision": {
            "type": "null"
          },
          "published": {
            "const": false
          }
        }
      },
      "else": {
        "properties": {
          "sourceRevision": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "published": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "sourceMode": {
            "const": "committed"
          },
          "digestKind": {
            "const": "manifest"
          },
          "reference": {
            "pattern": "@sha256:[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "digestKind": {
            "const": "image-id"
          }
        }
      }
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
